{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/locale/en-us/setting.lua",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".annotations",
    "C:/Users/rubin/.cursor/extensions/ketho.wow-api/Annotations/Core"
  ],
  "workspace.ignoreDir": [
    ".release",
    "assets",
    "tests"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "C_AddOns",
    "GearStatsDB",
    "GearStats_OnAddonCompartmentClick",
    "GearStats_OnAddonCompartmentEnter",
    "GearStats_OnAddonCompartmentLeave",
    "SLASH_GEARSTATS1",
    "SLASH_GEARSTATS2",
    "issecretvalue",
    "canaccessvalue",
    "issecrettable",
    "canaccesstable",
    "C_Spell",
    "C_SpellBook",
    "C_Timer",
    "C_UnitAuras",
    "Enum",
    "TooltipDataProcessor",
    "CreateFrame",
    "GetManaRegen",
    "IsPlayerSpell",
    "UnitClass",
    "UnitLevel",
    "UnitStat",
    "GameTooltip",
    "GetCursorPosition",
    "Minimap",
    "Settings",
    "print"
  ],
  "diagnostics.severity": {
    "undefined-global": "Error",
    "unused-local": "Error",
    "unused-function": "Error",
    "param-type-mismatch": "Error",
    "missing-return": "Error",
    "need-check-nil": "Error",
    "redundant-parameter": "Error",
    "cast-type-mismatch": "Error"
  }
}
